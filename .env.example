# =============================================================================
# ⚡ LinkForge — Production Environment Variables Reference
# -----------------------------------------------------------------------------
# Copy this file to create your local or production environment:
# Local:   cp .env.example .env
# Vercel:  Project Settings -> Environment Variables
# =============================================================================

# =============================================================================
# 1. 🗄️ DATABASE CONFIGURATION (Choose One Provider)
# =============================================================================
# Options: postgres | neon | supabase | turso | d1
DATABASE_PROVIDER=neon

# -----------------------------------------------------------------------------
# OPTION A: Neon Serverless Postgres (RECOMMENDED FOR VERCEL — 0.5 GB Free Tier)
# -----------------------------------------------------------------------------
# 🔗 Where to get it:
# 1. Go to https://console.neon.tech/
# 2. Select your Project -> Dashboard.
# 3. Under "Connection Details", select "Pooled connection" or standard.
# 4. Copy the connection string.
#
# 🔒 Vercel Type: SECRET (Tick "Sensitive" checkbox)
# 📄 Looks like: postgresql://[user]:[password]@[endpoint].neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://neondb_owner:npg_YourPasswordHere@ep-cool-frost-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# -----------------------------------------------------------------------------
# OPTION B: Supabase Postgres (500 MB Free Tier)
# -----------------------------------------------------------------------------
# 🔗 Where to get it:
# 1. Go to https://supabase.com/dashboard/project/_/settings/database
# 2. Under "Connection string", select "URI" (or Session Pooler port 5432/6543).
# 3. Replace [YOUR-PASSWORD] with your database password.
#
# 🔒 Vercel Type: SECRET
# SUPABASE_DATABASE_URL=postgresql://postgres.yourprojectid:YourPasswordHere@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# -----------------------------------------------------------------------------
# OPTION C: Turso LibSQL Edge SQLite (1 GB Free Tier)
# -----------------------------------------------------------------------------
# 🔗 Where to get it:
# Run: turso db create linkforge && turso db show linkforge --url
# Run: turso db tokens create linkforge
#
# 📄 TURSO_DATABASE_URL looks like: libsql://linkforge-yourname.turso.io
# 🔒 TURSO_AUTH_TOKEN looks like:   eyJhbGciOi... (JWT string)
# TURSO_DATABASE_URL=libsql://linkforge-yourusername.turso.io
# TURSO_AUTH_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# -----------------------------------------------------------------------------
# OPTION D: Local Self-Hosted Postgres
# -----------------------------------------------------------------------------
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# -----------------------------------------------------------------------------
# OPTION E: Upstash Redis (Optional: Distributed Rate Limiting & Edge Caching)
# -----------------------------------------------------------------------------
# 🔗 Where to get it: https://console.upstash.com/redis
# UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
# UPSTASH_REDIS_REST_TOKEN=AX...


# =============================================================================
# 2. 🔐 AUTHENTICATION & SECURITY
# =============================================================================
# Options: builtin | neon | supabase | clerk | nextauth
AUTH_PROVIDER=builtin

# -----------------------------------------------------------------------------
# AUTH_SECRET (CRITICAL FOR SESSION SIGNING & PRIVACY IP HASHING)
# -----------------------------------------------------------------------------
# 🔗 How to generate a secure 32-byte (64 hex characters) secret:
# In your terminal, run:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Or:
#   openssl rand -hex 32
#
# 🔒 Vercel Type: SECRET (Tick "Sensitive" checkbox)
# 📄 Looks like: 64 hexadecimal characters (e.g. 7f83b1657ff1fc53b92dc18148a1d65dfc2d4b1fa3d677284addd200126d9069)
AUTH_SECRET=b79a32c4e1f85d9082ac3f0982d61b3e7a1c5d9e0f2b4c6e8a1d3f5b7c9e1a3d


# =============================================================================
# 3. 📦 OBJECT STORAGE (BACKBLAZE B2 PRIVATE VAULT — 10 GB Free Tier)
# =============================================================================
# Options: b2 | r2 | s3 | minio | local | vercel-blob
STORAGE_PROVIDER=b2
STORAGE_DRIVER=b2

# -----------------------------------------------------------------------------
# Step-by-Step Backblaze B2 Vault Setup:
# -----------------------------------------------------------------------------
# Step 1: Create a 100% Private Bucket:
# 🔗 Go to: https://secure.backblaze.com/b2_buckets.htm
# Click "Create a Bucket":
#   - Bucket Unique Name: (e.g. my-linkforge-private-vault)
#   - Files in Bucket are: Select "Private" (No public access!)
#   - Default Encryption: Enabled
# Copy the exact bucket name to B2_BUCKET_NAME and B2_BUCKET.
#
# 📄 Vercel Type: Plain Text
B2_BUCKET_NAME=my-linkforge-private-vault
B2_BUCKET=my-linkforge-private-vault

# Step 2: Find Your S3 Endpoint & Region:
# In the Buckets table, look at the "Endpoint" column for your bucket.
# 📄 Looks like: s3.us-east-005.backblazeb2.com (Do NOT prepend https://)
# Region is the cluster code: us-east-005 (or us-west-004, eu-central-003, etc.)
#
# 📄 Vercel Type: Plain Text
B2_ENDPOINT=s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005

# Step 3: Create an Application Key:
# 🔗 Go to: https://secure.backblaze.com/app_keys.htm
# Click "Add a New Application Key":
#   - Name of Key: linkforge-app-key
#   - Allow access to Bucket: Select your bucket name
#   - Type of Access: "Read and Write"
# Click "Create New Key" — Backblaze will show your credentials ONCE:
#
# A) keyID:
# 📄 Vercel Type: Plain Text
# 📄 Looks like: 005abc1234567890000000001 (starts with cluster number)
B2_APPLICATION_KEY_ID=005abc1234567890000000001
B2_KEY_ID=005abc1234567890000000001

# B) applicationKey:
# 🔒 Vercel Type: SECRET (Tick "Sensitive" checkbox — NEVER expose client-side)
# 📄 Looks like: K005abcDefGhi123JklMnoPqr456Stu
B2_APPLICATION_KEY=K005abcDefGhi123JklMnoPqr456Stu

# Enforce 100% private vault mode:
B2_PRIVATE_BUCKET=true

# Presigned URL Lifetimes (Seconds):
B2_PRESIGN_PUT_EXPIRY_SEC=600   # 10 minutes for direct browser upload
B2_PRESIGN_GET_EXPIRY_SEC=300   # 5 minutes for direct download

# -----------------------------------------------------------------------------
# B2 CORS Allowed Domains (For Direct Browser-to-B2 Uploads)
# -----------------------------------------------------------------------------
# Comma-separated domains allowed to upload directly to your B2 bucket.
# You can also sync these automatically by POSTing to /api/storage/cors
#
# 📄 Vercel Type: Plain Text
B2_CORS_ALLOWED_ORIGINS=https://inkorge-demo.vercel.app,https://linkforge-delta.vercel.app,http://localhost:3000

# -----------------------------------------------------------------------------
# Max File Upload Limit (MB)
# -----------------------------------------------------------------------------
# Default is 50 MB. Can be customized freely (e.g. 50, 100, 200).
NEXT_PUBLIC_MAX_UPLOAD_MB=50
MAX_UPLOAD_MB=50

# -----------------------------------------------------------------------------
# Local Storage Fallback (Self-hosted default when STORAGE_PROVIDER=local)
# -----------------------------------------------------------------------------
UPLOAD_DIR=./uploads


# =============================================================================
# 4. 🌐 DEPLOYMENT & HOSTING CONFIGURATION
# =============================================================================
# Options: vercel | cloudflare | netlify | railway | render
DEPLOYMENT_PLATFORM=vercel

# -----------------------------------------------------------------------------
# NEXT_PUBLIC_APP_URL
# -----------------------------------------------------------------------------
# Your active production domain (without trailing slash).
# Used for public link redirects, OpenGraph image cards, and CORS matching.
#
# 📄 Vercel Type: Plain Text
NEXT_PUBLIC_APP_URL=https://inkorge-demo.vercel.app

# Custom root domain routing (Optional, e.g. linkforge.app):
APP_DOMAIN=


# =============================================================================
# 5. 📊 DUCKDB OLAP ANALYTICS & DATABASE SPACE COMPACTION
# =============================================================================
# Enables privacy-first event tracking (views, link clicks, device, geo).
ANALYTICS_ENABLED=true

# Probabilistic retention garbage collection (days before raw event rows are pruned).
# Note: Compact daily rollups preserve lifetime stats permanently in 98% less space!
ANALYTICS_RETENTION_DAYS=30

# Comma-separated allowed origins for Public REST API /api/v1/*
API_CORS_ORIGINS=*

# =============================================================================
# 🔧 LinkForge — Environment Variables (sab kuch yahan se, koi hardcode nahi)
# Copy: cp .env.example .env
# =============================================================================

# ===== DATABASE (choose one provider) =====
DATABASE_PROVIDER=postgres          # postgres | neon | supabase | turso | d1

# --- Local / Railway / Render Postgres (default)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# --- Neon (serverless postgres — https://neon.tech) — free: 0.5 GB
# NEON_DATABASE_URL=postgresql://...@....neon.tech/neondb?sslmode=require
# NEON_AUTH_URL=https://...                     # sirf AUTH_PROVIDER=neon ke liye

# --- Supabase (postgres — https://supabase.com) — free: 500 MB
# SUPABASE_URL=https://xyz.supabase.co
# SUPABASE_ANON_KEY=eyJ...
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
# SUPABASE_DATABASE_URL=postgresql://postgres:[pass]@aws-0-...pooler.supabase.com:6543/postgres

# --- Turso (distributed sqlite — https://turso.tech) — free: 1 GB
# TURSO_DATABASE_URL=libsql://your-db-....turso.io
# TURSO_AUTH_TOKEN=eyJ...

# --- Cloudflare D1 (edge sqlite — https://workers.cloudflare.com) — free: 5 GB
# NOTE: EXPERIMENTAL — Workers binding wiring verify nahi hui (docs/database.md).
# D1_DATABASE_ID=xxxx
# D1_ACCOUNT_ID=xxxx
# D1_AUTH_TOKEN=xxxx

# --- Upstash Redis (rate limiting / cache — https://upstash.com)
# UPSTASH_REDIS_REST_URL=https://....upstash.io
# UPSTASH_REDIS_REST_TOKEN=A....
# UPSTASH_REDIS_URL=                            # https:// URL bhi chalega
# UPSTASH_REDIS_TOKEN=

# ===== AUTH (choose one provider) =====
# NOTE: `builtin` fully working hai. `supabase` me sirf email/password REST
# working hai (social callbacks baki). `clerk` / `nextauth` / `neon` =
# NOT IMPLEMENTED (501 aayega) — docs/auth.md dekhein.
AUTH_PROVIDER=builtin               # builtin | neon | supabase | clerk | nextauth
AUTH_SECRET=change-me-32-bytes-random-secret   # session signing + IP hash salt
# NEXTAUTH_URL=http://localhost:3000            # sirf AUTH_PROVIDER=nextauth ke liye (NOT IMPLEMENTED)
# CLERK_SECRET_KEY=                             # NOT IMPLEMENTED
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=            # NOT IMPLEMENTED

# ===== MAIL (password reset delivery) =====
# Default: console (dev logs). Outbox queue hamesha `mail_outbox` table me rehta hai.
# MAIL_PROVIDER=console              # console | smtp | mailhog
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="LinkForge <no-reply@example.com>"

# ===== STORAGE (choose one provider) =====
STORAGE_DRIVER=b2                   # local | b2 | r2 | s3 | minio | vercel-blob (STORAGE_PROVIDER alias)
STORAGE_PROVIDER=b2

# --- Local disk (self-hosted default)
UPLOAD_DIR=./uploads

# --- Backblaze B2 (100% Private Zero-Leak Vault — https://backblaze.com) — free: 10 GB
# B2_BUCKET (ya B2_BUCKET_NAME)
B2_BUCKET=my-app-private-vault
B2_BUCKET_NAME=my-app-private-vault
# B2_KEY_ID (ya B2_APPLICATION_KEY_ID)
B2_KEY_ID=your_b2_application_key_id
B2_APPLICATION_KEY_ID=your_b2_application_key_id
# B2_APPLICATION_KEY (ya B2_APP_KEY)
B2_APPLICATION_KEY=your_b2_application_key
B2_REGION=us-east-005
B2_ENDPOINT=s3.us-east-005.backblazeb2.com
B2_PRESIGN_PUT_EXPIRY_SEC=600
B2_PRESIGN_GET_EXPIRY_SEC=300
B2_PRIVATE_BUCKET=true
# B2_PUBLIC_URL=https://your-cdn-or-bucket-url   # sirf optional public CDN ke liye

# --- Cloudflare R2 (zero egress — https://cloudflare.com) — free: 10 GB
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_URL=https://pub-....r2.dev

# --- AWS S3 (pay-as-you-go)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_BUCKET_NAME=
# AWS_PUBLIC_URL=                                  # optional CDN URL

# --- MinIO (self-hosted S3 — unlimited)
# MINIO_ENDPOINT=http://localhost:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET_NAME=linkforge
# MINIO_PUBLIC_URL=http://localhost:9000/linkforge

# --- Vercel Blob — free: 10 GB
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_....

# ===== DEPLOYMENT =====
DEPLOYMENT_PLATFORM=vercel          # vercel | cloudflare | netlify | railway | render
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_DOMAIN=                         # e.g. linkforge.app — custom-domain routing ke liye

# ===== ANALYTICS =====
ANALYTICS_ENABLED=true
ANALYTICS_RETENTION_DAYS=30

# ===== PUBLIC API =====
API_CORS_ORIGINS=*                  # comma-separated allowed origins for /api/v1/*

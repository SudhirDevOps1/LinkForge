{
  "name": "nextjs-postgresql-template",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:migrate": "tsx scripts/auto-migrate.ts",
    "db:push:turso": "drizzle-kit push --config drizzle.config.turso.ts",
    "db:push:d1": "drizzle-kit push --config drizzle.config.d1.ts",
    "cleanup:uploads": "tsx scripts/cleanup-uploads.ts",
    "deploy:vercel": "vercel --prod",
    "deploy:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "deploy:netlify": "netlify deploy --prod"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1128.0",
    "@aws-sdk/s3-request-presigner": "^3.1128.0",
    "@better-auth/drizzle-adapter": "^1.7.4",
    "@better-auth/passkey": "^1.7.4",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@libsql/client": "^0.18.0",
    "@neondatabase/serverless": "^1.1.0",
    "@types/qrcode": "^1.5.6",
    "@vercel/blob": "^2.8.0",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.7.4",
    "clsx": "^2.1.1",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "file-type": "^22.0.2",
    "lucide-react": "^1.43.0",
    "next": "^16.3.4",
    "pg": "8.23.0",
    "pg-cloudflare": "^1.4.0",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tsx": "^4.23.13",
    "vitest": "^5.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.3.4",
    "postcss": "8.5.28",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "wrangler": "^4.130.0"
  }
}
